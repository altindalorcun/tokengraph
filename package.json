{
  "name": "tokengraph-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "build": "npm run build --workspaces --if-present",
    "bundle": "npm run build -w tokengraph",
    "samples": "npm run build -w tokengraph && node scripts/samples.mjs",
    "smoke": "npm run build -w tokengraph && node scripts/smoke-story.mjs --packed",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jsqr": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
