{
  "name": "tokengraph-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "build": "npm run build --workspaces --if-present",
    "bundle": "npm run build -w tokengraph"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jsqr": "^1.4.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
