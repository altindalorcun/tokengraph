{
  "name": "tokengraph",
  "version": "0.1.0",
  "description": "A GitHub-style graph of the tokens your AI coding agents burn each day: Claude Code, Codex CLI, Cursor, Gemini CLI, Cline and OpenCode.",
  "keywords": [
    "ai",
    "tokens",
    "usage",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "cline",
    "opencode",
    "heatmap",
    "cli"
  ],
  "license": "MIT",
  "author": "altindalorcun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altindalorcun/tokengraph.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/altindalorcun/tokengraph#readme",
  "bugs": {
    "url": "https://github.com/altindalorcun/tokengraph/issues"
  },
  "type": "module",
  "bin": {
    "tokengraph": "./bundle/bin.js"
  },
  "files": [
    "bundle"
  ],
  "scripts": {
    "build": "tsc --build && esbuild dist/bin.js --bundle --platform=node --format=esm --target=node22 --external:zod --outfile=bundle/bin.js --log-level=warning",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tokengraph/core": "0.1.0",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
